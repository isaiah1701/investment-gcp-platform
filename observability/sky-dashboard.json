{
  "uid": "sky-overview",
  "title": "Sky Overview",
  "tags": ["sky", "weather"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "title": "Request rate", "type": "timeseries", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(rate(sky_http_requests_total[5m]))", "legendFormat": "requests / sec" }] },
    { "id": 2, "title": "HTTP error rate", "type": "timeseries", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(rate(sky_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(sky_http_requests_total[5m])), 0.001)", "legendFormat": "5xx ratio" }] },
    { "id": 3, "title": "P95 request latency", "type": "timeseries", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(sky_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 seconds" }] },
    { "id": 4, "title": "Weather API failures", "type": "timeseries", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(rate(sky_weather_api_requests_total{result=\"failure\"}[5m]))", "legendFormat": "failures / sec" }] },
    { "id": 5, "title": "Sky pod CPU and memory", "type": "timeseries", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"sky\",container=\"sky\"}[5m]))", "legendFormat": "CPU cores" }, { "expr": "sum(container_memory_working_set_bytes{namespace=\"sky\",container=\"sky\"})", "legendFormat": "memory bytes" }] },
    { "id": 6, "title": "Sky pod restarts", "type": "timeseries", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"sky\",pod=~\"sky-.*\"}[1h]))", "legendFormat": "restarts / hour" }] }
  ],
  "annotations": { "list": [] }
}
